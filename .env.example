# Database
# Connection pool limits:
# - Backend API: connection_limit=10 (default for web servers)
# - Scraper Agents: connection_limit=5 (fewer, long-running connections)
# - Production: connection_limit=20-50 (based on instance size)
DATABASE_URL="postgresql://sloevents:localdev123@localhost:6432/sloevents?connection_limit=10&pool_timeout=20&connect_timeout=10"

# Database logging
LOG_QUERIES="false" # Set to "true" to log all SQL queries (verbose)

# Redis
REDIS_URL="redis://localhost:6381"

# API Keys (get from respective providers)
ANTHROPIC_API_KEY="sk-ant-..."
OPENAI_API_KEY="sk-..."

# Spotify API (for artist enrichment)
# Get from: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID="..."
SPOTIFY_CLIENT_SECRET="..."

# YouTube API (optional, for artist enrichment)
# Get from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY="..."

# Application
NODE_ENV="development"
PORT="6001"
API_URL="http://localhost:6001"
CORS_ORIGIN="http://localhost:6100"

# JWT Secrets (generate with: openssl rand -base64 32)
JWT_SECRET="your-secret-key-here-change-in-production"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="your-refresh-secret-here-change-in-production"
JWT_REFRESH_EXPIRES_IN="30d"

# Redis
REDIS_HOST="localhost"
REDIS_PORT="6381"
REDIS_PASSWORD=""

# Email (using Mailhog for local dev)
SMTP_HOST="localhost"
SMTP_PORT=6025
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@sloevents.local"

# External APIs (optional for MVP)
EVENTBRITE_API_KEY=""
MEETUP_API_KEY=""
BANDSINTOWN_API_KEY=""
SONGKICK_API_KEY=""

# Instagram Scraping (Educational/Testing Only - Against ToS)
# ⚠️ WARNING: Use dedicated account, not personal. High ban risk.
INSTAGRAM_USERNAME=""
INSTAGRAM_PASSWORD=""
INSTAGRAM_RATE_LIMIT_REQUESTS="10"  # Max requests per hour (very conservative)
INSTAGRAM_RATE_LIMIT_WINDOW="3600"  # Window in seconds (1 hour)
