{
  "name": "@slo-events/agents",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered event scraping and orchestration agents for SLO Events Platform",
  "main": "dist/index.js",
  "bin": {
    "agents": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx watch src/orchestrator/index.ts",
    "build": "tsc",
    "start": "node dist/orchestrator/index.js",
    "cli": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist",
    "scrape:all": "tsx src/cli.ts run-all",
    "scrape:fremont": "tsx src/cli.ts run fremont-theater",
    "scrape:slo-brew": "tsx src/cli.ts run slo-brew",
    "scrape:pac": "tsx src/cli.ts run pac-slo",
    "scrape:cal-poly": "tsx src/cli.ts run cal-poly-arts",
    "scrape:madonna": "tsx src/cli.ts run madonna-inn",
    "scrape:frog-peach": "tsx src/cli.ts run frog-and-peach",
    "scrape:the-mark": "tsx src/cli.ts run the-mark",
    "scrape:black-sheep": "tsx src/cli.ts run black-sheep",
    "scrape:libertine": "tsx src/cli.ts run libertine-brewing",
    "scrape:bang-drum": "tsx src/cli.ts run bang-the-drum",
    "scrape:humdinger": "tsx src/cli.ts run humdinger-slo",
    "scrape:shindig": "tsx src/cli.ts run shindig-cider",
    "scrape:downtown": "tsx src/cli.ts run downtown-slo",
    "scrape:big-big-slo": "tsx src/cli.ts run big-big-slo",
    "scrape:visit-slo": "tsx src/cli.ts run visit-slo",
    "scrape:cal-poly-athletics": "tsx src/cli.ts run cal-poly-athletics",
    "scrape:mulligans": "tsx src/cli.ts run mulligans-bar-grill",
    "find-dupes": "tsx src/scripts/deduplicate.ts",
    "merge-dupes": "tsx src/scripts/deduplicate.ts --auto-merge",
    "find-recurring": "tsx src/scripts/detect-recurring.ts",
    "mark-recurring": "tsx src/scripts/detect-recurring.ts --auto-mark",
    "find-recurring-keywords": "tsx src/scripts/mark-by-keywords.ts",
    "mark-recurring-keywords": "tsx src/scripts/mark-by-keywords.ts --auto-mark",
    "delete-venue-events": "tsx src/scripts/delete-venue-events.ts",
    "find-duplicate-venues": "tsx src/scripts/find-duplicate-venues.ts",
    "test-artist-enrichment": "tsx src/scripts/test-artist-enrichment.ts",
    "backfill-artists": "tsx src/scripts/backfill-artist-data.ts",
    "compare-scrapers": "tsx src/scripts/compare-scrapers.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.1",
    "@aws-sdk/client-s3": "^3.1030.0",
    "@slo-events/database": "workspace:*",
    "@slo-events/types": "workspace:*",
    "bullmq": "^5.34.0",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.7",
    "ioredis": "^5.4.2",
    "openai": "^4.76.1",
    "playwright": "^1.49.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "undici": "6",
    "winston": "^3.17.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "tsx": "^4.20.6",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
