{
  "name": "slo-events",
  "version": "0.1.0",
  "private": true,
  "description": "AI-First SLO Events Platform - Discover all events in San Luis Obispo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "./start.sh",
    "dev": "turbo run dev --filter=!@slo-events/agents",
    "dev:all": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:unit": "turbo run test --filter='!@slo-events/e2e'",
    "test:e2e": "cd apps/e2e && pnpm test",
    "test:e2e:ui": "cd apps/e2e && pnpm test:ui",
    "test:coverage": "turbo run test:coverage",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "db:push": "cd packages/database && pnpm prisma db push",
    "db:studio": "cd packages/database && pnpm prisma studio",
    "db:migrate": "cd packages/database && pnpm prisma migrate dev",
    "db:seed": "cd packages/database && pnpm db:seed"
  },
  "devDependencies": {
    "@turbo/gen": "^2.3.3",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
