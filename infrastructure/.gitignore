# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore Mac DS_Store files
.DS_Store

# Ignore plan files
*.tfplan

# Ignore Lambda placeholder zips
modules/lambda/lambda_placeholder.zip

# Ignore temporary files
*.tmp
*.backup
*.bak

# Ignore lock files (optional - some teams commit this)
# .terraform.lock.hcl
